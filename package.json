{
  "name": "optora",
  "version": "2.0.0",
  "main": "dist/index.js",
  "description": "Optora — Lightweight OTP email verification API with code-based and one-click magic-link flows. Node.js + Express + MongoDB + Nodemailer. Vercel-ready.",
  "author": "pooraddyy",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "build:web": "cd web && npm run build && rm -rf ../public/assets ../public/__manus__ ../public/index.html ../public/.gitkeep && cp -R dist/public/. ../public/ && rm -rf ../public/__manus__ ../public/.gitkeep",
    "build:deploy": "npm run build && npm run build:web",
    "vercel-build": "npm run build:deploy",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pooraddyy/optora.git"
  },
  "bugs": {
    "url": "https://github.com/pooraddyy/optora/issues"
  },
  "homepage": "https://github.com/pooraddyy/optora#readme",
  "keywords": [
    "otp",
    "optora",
    "email",
    "verification",
    "magic-link",
    "nodemailer",
    "express",
    "mongodb",
    "vercel"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.22.1",
    "mongoose": "^8.21.0",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.17",
    "@types/nodemailer": "^6.4.23",
    "dotenv": "^16.6.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
