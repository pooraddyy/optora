# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/mydatabase

# Gmail address used to send verification emails
GMAIL_USER=your-email@gmail.com

# Gmail App Password (not your account password)
GMAIL_PASS=your-gmail-app-password

# Base URL for magic link generation
# Example: https://api.example.com
APP_BASE_URL=http://localhost:3000

# API base URL shown in the interactive docs page
DOCS_API_URL=

# How long generated OTPs remain valid (in minutes)
OTP_VALIDITY_PERIOD_MINUTES=5

# Number of digits in the generated OTP
OTP_SIZE=6

# Maximum requests allowed per IP/email within the rate limit window
RATE_LIMIT_MAX_REQUESTS=5

# Rate limit window duration (in minutes)
RATE_LIMIT_WINDOW_MINUTES=15

# Comma-separated list of permitted email domains
# Leave empty to allow all domains
ALLOWED_DOMAINS=

# Comma-separated list of body keywords that trigger a spam block
# Example: casino,lottery,spam
BLOCK_KEYWORDS_RULES=
